{
  "name": "nightlight-disaster-observatory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:platform": "vitest run tests/error-contract.test.js tests/platform-boundary.test.js tests/public-boundary.test.js tests/release-manifest.test.js",
    "build": "vite build && node scripts/release-manifest.mjs --write",
    "verify:public": "node scripts/verify-public.mjs",
    "validate": "npm run test && npm run build && npm run verify:public -- --require-dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "3.5.21",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.11.2",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
