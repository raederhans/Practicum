{
  "name": "nightlight-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "analyze:bundle": "vite build --manifest && node scripts/report-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "npm run typecheck:browser && npm run typecheck:node",
    "typecheck:browser": "vue-tsc --noEmit -p tsconfig.browser.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "20.17.30",
    "@vitejs/plugin-vue": "^5.0.0",
    "playwright": "1.62.1",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.12"
  }
}
